DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cnpj_automation
APP_ENV=development
LOG_LEVEL=INFO
MAX_CNPJS_PER_JOB=500
CNPJWS_BASE_URL=https://publica.cnpj.ws
CNPJWS_TIMEOUT_SECONDS=15
CNPJWS_RATE_LIMIT_INTERVAL_SECONDS=21
CNPJWS_MAX_ATTEMPTS=3
CNPJWS_429_COOLDOWN_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_LEASE_SECONDS=60
RUN_EMBEDDED_WORKER=false
